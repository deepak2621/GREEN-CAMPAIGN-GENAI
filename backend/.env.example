# ==========================================
# Green Campaign AI - Backend Configuration
# ==========================================

# Application environment ('development' or 'production')
APP_ENV=development
FLASK_DEBUG=false

# Port for the Flask server
PORT=5000

# Secret key & JWT signing secret (change to a strong random string in production)
SECRET_KEY=replace-with-strong-random-secret-key
JWT_SECRET_KEY=replace-with-strong-random-jwt-secret
JWT_EXPIRATION_HOURS=24

# Frontend URL for verification & password reset links
FRONTEND_URL=http://localhost:5173

# Image Generation Provider:
# Local ComfyUI with FLUX.1 Dev (12B Q4_K_S GGUF)
IMAGE_PROVIDER=local_comfyui
COMFY_HOST=127.0.0.1
COMFY_PORT=8188
COMFY_DIR=C:\Users\deepa\ComfyUI

# Optional: Supabase Auth Verification (set when using Supabase Cloud Auth)
# Never expose SUPABASE_SERVICE_ROLE_KEY to the frontend!
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Optional: SMTP Configuration for sending real verification/reset emails in Local Mode
# Leave empty in development to use built-in local verification links
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@greencampaign.ai

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
