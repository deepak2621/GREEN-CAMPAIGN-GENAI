# ==========================================
# Green Campaign AI - Frontend Configuration
# ==========================================

# Backend API URL (Vite dev proxy handles /api automatically in development)
VITE_API_BASE_URL=/api

# Supabase Authentication (Optional for local mode; Required for Cloud Supabase Auth & Google OAuth)
# Find these in Supabase Dashboard -> Project Settings -> API
# IMPORTANT: Only use the public 'anon' key here. NEVER expose 'service_role' key in frontend!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

